{
  "name": "vynyl",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop Spotify customization studio",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/build-spicetify-extension.cjs && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build && node scripts/build-spicetify-extension.cjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.vynyl.desktop",
    "productName": "Vynyl",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "spotify-app/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
